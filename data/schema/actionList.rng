<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
         xmlns:il="http://dmchurch.github.io/omsi-loops/schema/1.0"
    datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
    <start>
        <element name="actions">
            <interleave>
                <optional>
                    <element name="defs">
                        <a:documentation>Definitions</a:documentation>
                        <zeroOrMore>
                            <ref name="anyDef"></ref>
                        </zeroOrMore>
                    </element>
                </optional>
                <zeroOrMore>
                    <element name="refs">
                        <zeroOrMore>
                            <attribute>
                                <anyName />
                            </attribute>
                        </zeroOrMore>
                        <ref name="type.refs" />
                    </element>
                </zeroOrMore>
                <zeroOrMore>
                    <ref name="anyAction"></ref>
                </zeroOrMore>
            </interleave>
        </element>
    </start>
    <define name="type.refs" combine="interleave">
        <element name="stats">
            <zeroOrMore>
                <element name="stat">
                    <text />
                </element>
            </zeroOrMore>
        </element>
    </define>
    <define name="type.refs" combine="interleave">
        <element name="skills">
            <zeroOrMore>
                <element name="skill">
                    <text />
                </element>
            </zeroOrMore>
        </element>
    </define>
    <define name="type.refs" combine="interleave">
        <element name="buffs">
            <zeroOrMore>
                <element name="buff">
                    <text />
                </element>
            </zeroOrMore>
        </element>
    </define>
    <define name="anyDef" combine="choice">
        <element name="defineAdjustment">
            <attribute name="name" />
            <zeroOrMore>
                <ref name="numericAdjustment"></ref>
            </zeroOrMore>
        </element>
    </define>
    <define name="numericEvaluation">
        <choice>
            <data type="decimal" />
            <group>
                <choice>
                    <attribute name="value">
                        <!-- <data type="decimal"/> -->
                    </attribute>
                    <ref name="baseValue"/>
                </choice>
                <zeroOrMore>
                    <ref name="numericAdjustment"></ref>
                </zeroOrMore>
            </group>
        </choice>
    </define>
    <define name="conditionalEvaluation">
        <zeroOrMore>
            <ref name="conditionalRules" />
        </zeroOrMore>
    </define>
    <define name="conditionalRules" combine="choice">
        <choice>
            <element name="if">
                <a:documentation>Execute a numeric evaluation and perform a test on its result.</a:documentation>
                <il:label>If arbitrary value</il:label>
                <ref name="numericEvaluation" />
                <ref name="numericTests" />
            </element>
            <element name="ifCurrentValue">
                <a:documentation>Test the current value of the numeric evaluation.</a:documentation>
                <il:label>If current evaluation</il:label>
                <ref name="numericCondition" />
            </element>
            <element name="ifResource">
                <ref name="required-resourceName" />
                <ref name="numericCondition" />
            </element>
            <element name="ifHasResource">
                <ref name="required-resourceName" />
                <ref name="booleanCondition" />
            </element>
            <element name="ifStoryFlag">
                <ref name="required-storyFlagName" />
                <ref name="booleanCondition" />
            </element>
            <element name="ifProgress">
                <ref name="optional-varName" />
                <ref name="numericCondition" />
            </element>
            <element name="ifGoodItems">
                <ref name="optional-varName" />
                <ref name="numericCondition" />
            </element>
            <element name="ifDiscoveredItems">
                <ref name="optional-varName" />
                <ref name="numericCondition" />
            </element>
            <element name="ifCheckedItems">
                <ref name="optional-varName" />
                <ref name="numericCondition" />
            </element>
            <element name="ifPrestige">
                <a:documentation>Test whether any prestige has been completed.</a:documentation>
                <il:label>If prestiged</il:label>
                <ref name="booleanCondition" />
            </element>
            <element name="ifTownUnlocked">
                <a:documentation>Test whether the given town has been unlocked.</a:documentation>
                <il:label>If town unlocked</il:label>
                <attribute name="townNum">
                    <data type="integer" />
                </attribute>
                <ref name="booleanCondition" />
            </element>
            <element name="anyOf">
                <a:documentation>True when ANY child condition passes (disjunction; the surrounding list is a conjunction).</a:documentation>
                <il:label>Any of</il:label>
                <ref name="booleanCondition" />
            </element>
            <element name="never">
                <a:documentation>Always false — for properties that are constant false (e.g. actions granted by other means).</a:documentation>
                <il:label>Never</il:label>
                <empty />
            </element>
            <element name="ifGuild">
                <a:documentation>Test the player's guild membership (guild="" tests for no guild).</a:documentation>
                <il:label>If guild</il:label>
                <attribute name="guild">
                    <choice>
                        <value></value>
                        <value>Adventure</value>
                        <value>Crafting</value>
                        <value>Explorer</value>
                        <value>Thieves</value>
                        <value>Assassin</value>
                    </choice>
                </attribute>
                <ref name="booleanCondition" />
            </element>
            <element name="ifGuildRankName">
                <a:documentation>Test a guild's current rank name. Note that the rank name the
                    game computes is DECORATED ("A+, Mult x1.4"), so a bare rank name never
                    matches — the JS bodies compare the same way, and JS is the oracle.</a:documentation>
                <il:label>If guild rank name</il:label>
                <attribute name="which">
                    <choice>
                        <value>craftGuild</value>
                        <value>wizCollege</value>
                    </choice>
                </attribute>
                <attribute name="name" />
                <ref name="booleanCondition" />
            </element>
            <element name="ifGlobalFlag">
                <a:documentation>Test a whitelisted boolean loop-temp global.</a:documentation>
                <il:label>If global flag</il:label>
                <!-- Names here must also be whitelisted in actionListXml.js -->
                <attribute name="name">
                    <choice>
                        <value>portalUsed</value>
                    </choice>
                </attribute>
                <ref name="booleanCondition" />
            </element>
            <element name="ifSoulstoneSac">
                <a:documentation>True when the total soulstone pool covers the amount given by
                    the child evaluation (checkSoulstoneSac).</a:documentation>
                <il:label>If soulstones cover</il:label>
                <optional>
                    <attribute name="inverted">
                        <value>inverted</value>
                    </attribute>
                </optional>
                <ref name="numericEvaluation" />
            </element>
        </choice>
    </define>
    <define name="required-statName">
        <attribute name="statName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="required-skillName">
        <attribute name="skillName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="required-buffName">
        <attribute name="buffName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="required-prestigeBuffName">
        <attribute name="prestigeBuffName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="required-resourceName">
        <attribute name="resourceName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="required-storyFlagName">
        <attribute name="storyFlagName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="required-actionName">
        <attribute name="actionName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="optional-actionName">
        <optional>
            <ref name="required-actionName" />
        </optional>
    </define>
    <define name="required-varName">
        <attribute name="varName">
            <il:source domain="varName">
                <il:varName />
            </il:source>
            <data type="NCName" />
        </attribute>
    </define>
    <define name="optional-varName">
        <optional>
            <ref name="required-varName" />
        </optional>
    </define>
    <define name="required-functionName">
        <attribute name="functionName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="required-adjustmentName">
        <attribute name="adjustmentName">
            <data type="NCName" />
        </attribute>
    </define>
    <define name="booleanCondition">
        <ref name="conditionalEvaluation" />
        <optional>
            <attribute name="inverted">
                <choice>
                    <value>inverted</value>
                    <empty />
                </choice>
            </attribute>
        </optional>
    </define>
    <define name="numericCondition">
        <ref name="conditionalEvaluation" />
        <ref name="numericTests" />
    </define>
    <define name="numericTests">
        <optional>
            <attribute name="min">
                <data type="decimal" />
            </attribute>
        </optional>
        <optional>
            <attribute name="minExclusive">
                <data type="decimal" />
            </attribute>
        </optional>
        <optional>
            <attribute name="max">
                <data type="decimal" />
            </attribute>
        </optional>
        <optional>
            <attribute name="maxExclusive">
                <data type="decimal" />
            </attribute>
        </optional>
        <optional>
            <attribute name="equals">
                <data type="decimal" />
            </attribute>
        </optional>
        <optional>
            <attribute name="notEquals">
                <data type="decimal" />
            </attribute>
        </optional>
    </define>
    <define name="baseValue" combine="choice">
        <element name="skillLevel">
            <a:documentation>The current level in a given skill, as an integer.</a:documentation>
            <il:label>Skill Level</il:label>
            <ref name="required-skillName" />
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="buffLevel">
            <a:documentation>The current level of a given buff, as an integer.</a:documentation>
            <il:label>Buff Level</il:label>
            <ref name="required-buffName" />
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="primaryValue">
            <a:documentation>The current result of the "Primary Value" attribute of the given action (the current action, if omitted)</a:documentation>
            <il:label>Primary Value of Action</il:label>
            <ref name="optional-actionName" />
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="progressLevel">
            <a:documentation>The current percentage level displayed to the user for the given action, as an integer.</a:documentation>
            <il:label>Progress Level</il:label>
            <ref name="required-varName">
                <il:varName type="progress" />
            </ref>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="goodItems">
            <a:documentation>The number of known-good items of a given action (the current action, if omitted), as an integer.</a:documentation>
            <il:label>Total known-good items</il:label>
            <ref name="required-varName">
                <il:varName type="limited" />
            </ref>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="discoveredItems">
            <a:documentation>The total number of items discovered of a given action (the current action, if omitted), as an integer.</a:documentation>
            <il:label>Total discovered items</il:label>
            <ref name="required-varName">
                <il:varName type="limited" />
            </ref>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="checkedItems">
            <a:documentation>The total number of items checked for a given action (the current action, if omitted), as an integer.</a:documentation>
            <il:label>Total checked items</il:label>
            <ref name="required-varName">
                <il:varName type="limited" />
            </ref>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="value">
            <a:documentation>A complex numeric evaluation, used as the source for this one.</a:documentation>
            <il:label>Calculated Value</il:label>
            <ref name="numericEvaluation" />
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="skillExp">
            <a:documentation>The raw experience in a given skill (within the current level).</a:documentation>
            <il:label>Skill Exp</il:label>
            <ref name="required-skillName" />
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="stonesUsed">
            <a:documentation>Stones used from the given zone's ruins (the action's own town if townNum is omitted).</a:documentation>
            <il:label>Stones used</il:label>
            <optional>
                <attribute name="townNum">
                    <data type="integer" />
                </attribute>
            </optional>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="talentLevel">
            <a:documentation>The current talent level of a given stat, as an integer.</a:documentation>
            <il:label>Talent Level</il:label>
            <ref name="required-statName" />
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="resourceValue">
            <a:documentation>The current amount of a numeric resource.</a:documentation>
            <il:label>Resource amount</il:label>
            <attribute name="name" />
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="townValue">
            <a:documentation>A named numeric field of a town (the action's own town if townNum is omitted), e.g. suppliesCost.</a:documentation>
            <il:label>Town value</il:label>
            <attribute name="name" />
            <optional>
                <attribute name="townNum">
                    <data type="integer" />
                </attribute>
            </optional>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="globalValue">
            <a:documentation>A whitelisted global game value.</a:documentation>
            <il:label>Global value</il:label>
            <!-- Names here must also be whitelisted in actionListXml.js -->
            <attribute name="name">
                <choice>
                    <value>trainingLimits</value>
                    <value>goldInvested</value>
                    <value>storyMax</value>
                    <value>effectiveTime</value>
                </choice>
            </attribute>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="storyVar">
            <a:documentation>A persistent numeric story variable (-1 until first set).</a:documentation>
            <il:label>Story variable</il:label>
            <attribute name="name">
                <choice>
                    <value>maxWizardGuildSegmentCleared</value>
                    <value>maxZombiesRaised</value>
                </choice>
            </attribute>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <element name="function">
            <a:documentation>The result of calling a named JavaScript function.</a:documentation>
            <il:label>JS function</il:label>
            <!-- Functions named here must also be named in schema.js; the
                 *Bonus names are fork wrappers for getXRank().bonus (a
                 <function> must return a number) -->
            <attribute name="name">
                <choice>
                    <value>getExploreProgress</value>
                    <value>fullyExploredZones</value>
                    <value>totalAssassinations</value>
                    <value>getWizCollegeRankBonus</value>
                    <value>getCraftGuildRankBonus</value>
                    <value>getSelfCombat</value>
                    <value>getTeamCombat</value>
                    <value>getZombieStrength</value>
                    <value>minTalent</value>
                </choice>
            </attribute>
        </element>
    </define>
    <define name="baseValue" combine="choice">
        <choice>
            <element name="segment">
                <a:documentation>Multipart context: the segment index the evaluation was asked about
                    (only defined inside loopCost).</a:documentation>
                <il:label>Segment</il:label>
                <empty />
            </element>
            <element name="loopCounter">
                <a:documentation>Multipart context: the loop counter argument, defaulting to the
                    town's counter for this action. source="town" ignores the argument and always
                    reads the town's counter (trial canStart bodies do this).</a:documentation>
                <il:label>Loop counter</il:label>
                <optional>
                    <attribute name="source">
                        <value>town</value>
                    </attribute>
                </optional>
                <optional>
                    <!-- another action's town counter (Prepare Buffet scales off
                         how many survivors were rescued this loop) -->
                    <attribute name="varName" />
                </optional>
            </element>
            <element name="totalCompletions">
                <a:documentation>Multipart context: the total-completions argument, defaulting to
                    the town's total for this action.</a:documentation>
                <il:label>Total completions</il:label>
                <empty />
            </element>
            <element name="segments">
                <a:documentation>The action's segment count.</a:documentation>
                <il:label>Segment count</il:label>
                <empty />
            </element>
            <element name="power">
                <a:documentation>base raised to the child evaluation (Math.pow).</a:documentation>
                <il:label>Power</il:label>
                <attribute name="base">
                    <data type="decimal" />
                </attribute>
                <ref name="numericEvaluation" />
            </element>
            <element name="fibonacci">
                <a:documentation>fibonacci(n) of the child evaluation.</a:documentation>
                <il:label>Fibonacci</il:label>
                <ref name="numericEvaluation" />
            </element>
            <element name="dungeonCompleted">
                <a:documentation>Completions of the dungeon floor given by the child evaluation.</a:documentation>
                <il:label>Dungeon floor completions</il:label>
                <attribute name="dungeonNum">
                    <data type="integer" />
                </attribute>
                <ref name="numericEvaluation" />
            </element>
            <element name="dungeonFloors">
                <a:documentation>Floor count of a dungeon.</a:documentation>
                <il:label>Dungeon floors</il:label>
                <attribute name="dungeonNum">
                    <data type="integer" />
                </attribute>
            </element>
            <element name="trialCompleted">
                <a:documentation>Completions of the trial floor given by the child evaluation.</a:documentation>
                <il:label>Trial floor completions</il:label>
                <attribute name="trialNum">
                    <data type="integer" />
                </attribute>
                <ref name="numericEvaluation" />
            </element>
            <element name="trialFloors">
                <a:documentation>Floor count of a trial.</a:documentation>
                <il:label>Trial floors</il:label>
                <attribute name="trialNum">
                    <data type="integer" />
                </attribute>
            </element>
            <element name="currentFloor">
                <a:documentation>The trial/dungeon floor this action is currently on, derived
                    from its town loop counter. Valid inside effect bodies only.</a:documentation>
                <il:label>Current floor</il:label>
                <empty />
            </element>
            <element name="buffCap">
                <a:documentation>The configured cap of a buff (getBuffCap).</a:documentation>
                <il:label>Buff cap</il:label>
                <ref name="required-buffName" />
            </element>
            <element name="guildSegment">
                <a:documentation>A whitelisted cur*Segment rank counter.</a:documentation>
                <il:label>Guild segment counter</il:label>
                <!-- Names here must also be whitelisted in actionListXml.js -->
                <attribute name="name">
                    <choice>
                        <value>advGuild</value>
                        <value>craftGuild</value>
                        <value>thievesGuild</value>
                        <value>wizCollege</value>
                        <value>frostGiants</value>
                        <value>jungleMonsters</value>
                        <value>gods</value>
                    </choice>
                </attribute>
            </element>
        </choice>
    </define>
    <define name="numericAdjustment" combine="choice">
        <choice>
            <ref name="conditionalRules"></ref>
            <element name="addition">
                <ref name="numericEvaluation"/>
            </element>
            <element name="subtraction">
                <ref name="numericEvaluation"/>
            </element>
            <element name="multiplier">
                <ref name="numericEvaluation"/>
            </element>
            <element name="divisor">
                <ref name="numericEvaluation"/>
            </element>
            <element name="adjustment">
                <attribute name="name"/>
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="skillBonus">
                <attribute name="name"/>
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="skillMod">
                <attribute name="name"/>
                <attribute name="minExclusive">
                    <data type="integer" />
                </attribute>
                <attribute name="max">
                    <data type="integer" />
                </attribute>
                <attribute name="percentChange">
                    <data type="decimal" />
                </attribute>
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="prestigeBonus">
                <attribute name="name"/>
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="surveyBonus">
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="ceil">
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="floor">
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="round">
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="squareRoot">
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="absoluteValue">
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="precision3">
                <a:documentation>Round to 3 significant digits (helpers.js precision3).</a:documentation>
                <ref name="conditionalEvaluation"/>
            </element>
            <element name="additiveBonus">
                <oneOrMore>
                    <ref name="numericAdjustment"></ref>
                </oneOrMore>
            </element>
        </choice>
    </define>
    <define name="anyAction" combine="choice">
        <element name="action">
            <attribute name="type">
                <value>progress</value>
            </attribute>
            <interleave>
                <ref name="actionDefinition" />
                <optional>
                    <!-- the town progress this action's finish() grants
                         (finishProgress). Optional: a few amounts are still
                         Phase-6 comments. -->
                    <element name="progress">
                        <ref name="numericEvaluation" />
                    </element>
                </optional>
                <optional>
                    <!-- the rest of finish(): progress actions commonly also
                         grant skill exp, gold and story flags -->
                    <element name="reward">
                        <choice>
                            <ref name="nativeMarker" />
                            <ref name="rewardBody" />
                        </choice>
                    </element>
                </optional>
            </interleave>
        </element>
    </define>
    <define name="anyAction" combine="choice">
        <element name="action">
            <attribute name="type">
                <value>multipart</value>
            </attribute>
            <optional>
                <!-- segment count when it differs from the loopStats length
                     (Fight Monsters: 9 loopStats over 3 segments) -->
                <attribute name="segments">
                    <data type="positiveInteger" />
                </attribute>
            </optional>
            <interleave>
                <ref name="actionDefinition" />
                <element name="loopStats">
                    <oneOrMore>
                        <element name="stat">
                            <ref name="required-statName" />
                        </element>
                    </oneOrMore>
                </element>
                <element name="loopCost">
                    <a:documentation>Mana required for a segment: evaluated with the segment and
                        loopCounter context values.</a:documentation>
                    <choice>
                        <ref name="nativeMarker" />
                        <ref name="numericEvaluation" />
                    </choice>
                </element>
                <element name="tickProgress">
                    <a:documentation>Progress per tick: evaluated with the loopCounter and
                        totalCompletions context values.</a:documentation>
                    <choice>
                        <ref name="nativeMarker" />
                        <ref name="numericEvaluation" />
                    </choice>
                </element>
                <optional>
                    <element name="reward">
                        <a:documentation>finish() effects — a multipart action's finish runs once
                            per completed action, alongside its per-segment and per-loop
                            rewards.</a:documentation>
                        <choice>
                            <ref name="nativeMarker" />
                            <ref name="rewardBody" />
                        </choice>
                    </element>
                </optional>
                <optional>
                    <element name="segmentReward">
                        <a:documentation>segmentFinished() effects, as reward data (Phase-6
                            consumption, like reward).</a:documentation>
                        <zeroOrMore>
                            <ref name="resourceStack" />
                        </zeroOrMore>
                    </element>
                </optional>
                <optional>
                    <element name="loopReward">
                        <a:documentation>loopsFinished() effects, as reward data (Phase-6
                            consumption, like reward).</a:documentation>
                        <zeroOrMore>
                            <ref name="resourceStack" />
                        </zeroOrMore>
                    </element>
                </optional>
            </interleave>
        </element>
    </define>
    <define name="anyAction" combine="choice">
        <element name="action">
            <attribute name="type">
                <value>limited</value>
            </attribute>
            <interleave>
                <ref name="actionDefinition" />
                <element name="totalDiscovered">
                    <ref name="numericEvaluation"></ref>
                </element>
                <element name="oneInEvery">
                    <data type="positiveInteger"></data>
                </element>
                <element name="reward">
                    <choice>
                        <ref name="nativeMarker" />
                        <ref name="rewardBody" />
                    </choice>
                </element>
            </interleave>
        </element>
    </define>
    <define name="anyAction" combine="choice">
        <element name="action">
            <attribute name="type">
                <value>normal</value>
            </attribute>
            <interleave>
                <ref name="actionDefinition" />
                <element name="reward">
                    <choice>
                        <ref name="nativeMarker" />
                        <ref name="rewardBody" />
                    </choice>
                </element>
            </interleave>
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="numericResource">
            <attribute name="name" />
            <ref name="numericEvaluation" />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="booleanResource">
            <attribute name="name" />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="setStoryFlag">
            <attribute name="name" />
            <ref name="conditionalEvaluation" />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="progressExp">
            <a:documentation>Grant town progress exp to a named progress variable
                (finishProgress). The action's own progress goes in &lt;progress&gt;; this form is
                for the cross-variable writes (Throw Party feeds Met) and for progress actions
                whose grant sits in the middle of a longer finish body.</a:documentation>
            <il:label>Grant progress exp</il:label>
            <ref name="optional-varName" />
            <ref name="numericEvaluation" />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="storyVarMin">
            <a:documentation>Raise a story variable to at least this value (increaseStoryVarTo).</a:documentation>
            <il:label>Raise story var to</il:label>
            <attribute name="name" />
            <ref name="numericEvaluation" />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="setSkill">
            <a:documentation>Write one entry of this action's skills table before granting it.
                For the two actions whose skill amount is dynamic (Seek Blessing scales Divine
                with the Frost Giants rank; Prepare Buffet scales Gluttony with the Rescue loop
                counter) — the JS bodies mutate this.skills the same way.</a:documentation>
            <il:label>Set skill amount</il:label>
            <attribute name="name" />
            <ref name="numericEvaluation" />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="grantProgress">
            <a:documentation>Execute this action's own &lt;progress&gt; evaluation here
                (finishProgress). A marker rather than an amount, so &lt;progress&gt; stays the
                single source of truth — and so consumption is opt-in, since several actions
                carry &lt;progress&gt; alongside a finish body that is not modelled yet.</a:documentation>
            <il:label>Grant own progress</il:label>
            <empty />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="skillExp">
            <a:documentation>Grant this action's skill exp table (handleSkillExp). The amounts
                live on the action's own skills table, which stays runtime-authoritative.</a:documentation>
            <il:label>Grant skill exp</il:label>
            <empty />
        </element>
    </define>
    <define name="resourceStack" combine="choice">
        <element name="effect">
            <a:documentation>Invoke a whitelisted named effect primitive: composite, RNG-bearing
                or shared reward machinery whose implementation wraps the same JS helper the
                hand-written body calls. The XML vocabulary carries no draw/roll verbs.</a:documentation>
            <il:label>Effect</il:label>
            <attribute name="name" />
            <empty />
        </element>
    </define>
    <define name="rewardBody">
        <a:documentation>A reward body: effects in document order, plus the optional structural
            wrappers. For limited actions the bare effects run INSIDE the finishRegular reward
            callback; &lt;before&gt;/&lt;after&gt; hold the effects that sit outside it, and
            &lt;ledger&gt; is the amount finishRegular records in lootFrom{varName} (absent =
            the JS body returns nothing, so the ledger goes NaN — preserved, not fixed).</a:documentation>
        <interleave>
            <zeroOrMore>
                <ref name="resourceStack" />
            </zeroOrMore>
            <optional>
                <element name="before">
                    <zeroOrMore>
                        <ref name="resourceStack" />
                    </zeroOrMore>
                </element>
            </optional>
            <optional>
                <element name="after">
                    <zeroOrMore>
                        <ref name="resourceStack" />
                    </zeroOrMore>
                </element>
            </optional>
            <optional>
                <element name="ledger">
                    <ref name="numericEvaluation" />
                </element>
            </optional>
        </interleave>
    </define>
    <define name="nativeMarker">
        <a:documentation>This field keeps its hand-written JS implementation (the two-layer
            model's behavior slot) — for runtime-coupled fields like Continue On's allowed(),
            which reads the action queue.</a:documentation>
        <attribute name="native">
            <value>native</value>
        </attribute>
    </define>
    <define name="actionDefinition">
        <attribute name="name" />
        <optional>
            <attribute name="varName" />
        </optional>
        <optional>
            <!-- town the action belongs to; defaults to 0 -->
            <attribute name="townNum">
                <data type="integer" />
            </attribute>
        </optional>
        <interleave>
            <element name="expMult">
                <ref name="numericEvaluation" />
            </element>
            <optional>
                <element name="storyReqs">
                    <zeroOrMore>
                        <element name="story">
                            <attribute name="num">
                                <data type="integer"/>
                            </attribute>
                            <ref name="conditionalEvaluation" />
                        </element>
                    </zeroOrMore>
                </element>
            </optional>
            <element name="stats">
                <zeroOrMore>
                    <element name="stat">
                        <ref name="required-statName" />
                        <data type="decimal"/>
                    </element>
                </zeroOrMore>
            </element>
            <optional>
                <element name="affectedBy">
                    <zeroOrMore>
                        <element name="action">
                            <attribute name="name"/>
                        </element>
                    </zeroOrMore>
                </element>
            </optional>
            <optional>
                <element name="primaryValue">
                    <!-- this is goldCost() from the original -->
                    <ref name="numericEvaluation" />
                </element>
            </optional>
            <element name="effortCost">
                <ref name="numericEvaluation" />
            </element>
            <element name="visible">
                <ref name="conditionalEvaluation" />
            </element>
            <element name="unlocked">
                <ref name="conditionalEvaluation" />
            </element>
            <optional>
                <element name="cost">
                    <optional>
                        <!-- implied="none": the cost is deducted on completion but does
                             NOT gate canStart (e.g. Dark Magic drives reputation negative) -->
                        <attribute name="implied">
                            <value>none</value>
                        </attribute>
                    </optional>
                    <optional>
                        <!-- deduction="none": the element gates canStart only and the
                             deduction happens inside finish() (Map buys its own map) -->
                        <attribute name="deduction">
                            <value>none</value>
                        </attribute>
                    </optional>
                    <interleave>
                        <zeroOrMore>
                            <ref name="resourceStack" />
                        </zeroOrMore>
                        <optional>
                            <element name="deduction">
                                <a:documentation>Overrides the stacks for the DEDUCTION leg only.
                                    cost() runs after finish(), so an action whose finish changes
                                    the resource its cost is computed from (Gather Team) needs a
                                    separate expression from the canStart affordability one.</a:documentation>
                                <zeroOrMore>
                                    <ref name="resourceStack" />
                                </zeroOrMore>
                            </element>
                        </optional>
                    </interleave>
                </element>
            </optional>
            <optional>
                <element name="allowed">
                    <choice>
                        <ref name="nativeMarker" />
                        <ref name="numericEvaluation" />
                    </choice>
                </element>
            </optional>
            <optional>
                <element name="canStart">
                    <choice>
                        <ref name="nativeMarker" />
                        <ref name="conditionalEvaluation" />
                    </choice>
                </element>
            </optional>
        </interleave>
    </define>
</grammar>